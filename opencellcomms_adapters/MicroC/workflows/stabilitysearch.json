{
  "version": "2.0",
  "name": "MicroC stability search",
  "description": "Glucose-loop stability search on the standard 500-cell spheroid (radius ~253 um, ~9 % of the 75 x 75 bio-grid) centred in a 1500 um square domain, Glucose the only substance (fixed 5 mM boundary, fine 10 um solver grid), no gene network and no proliferation: each cell is glycoATP ON when its local glucose exceeds the 4 mM Glucose_supply threshold and a quiescent non-consumer otherwise (zero-delay relay). Each scheduler step a disc centred on the domain grows by 5 % of the side (75 um) and every cell inside becomes necrotic for good (zero metabolism, never removed), so the consuming population shrinks from the centre outward. Every iteration writes a seed checkpoint (iteration_plots/seeds/seed_ITER_NNNNNN.csv) that Read Checkpoint reloads as the starting population of another run at that fixed necrotic radius, plus the replot state checkpoint and the Glucose heatmap.",
  "kernel": "biophysics",
  "metadata": {
    "author": "MicroC stability search",
    "created": "2026-09-08",
    "workflow_source_path": "stabilitysearch.json",
    "gui": {
      "function_libraries": [],
      "agent_kinds": [
        {
          "name": "tumor_cell",
          "create_subworkflow": "tumor_cell_create",
          "behavior_subworkflows": [
            "necrosis_disc",
            "glucose_gate",
            "fate_summary"
          ]
        }
      ],
      "resource_kinds": [
        {
          "name": "Glucose",
          "init_subworkflow": "glucose_init",
          "behavior_subworkflows": [
            "diffusion_step"
          ]
        }
      ],
      "world": {
        "subworkflow": "__world__",
        "behavior_subworkflows": [
          "iteration_plots"
        ]
      },
      "init_sequence": {
        "subworkflow": "__init_sequence__"
      },
      "scheduler": {
        "subworkflow": "__scheduler__"
      },
      "processing": {
        "behavior_subworkflows": []
      },
      "main_is_synthesized": true,
      "user_functions": [],
      "contract_enforcement": "warn",
      "planner": {
        "version": 2,
        "replication": {
          "replicates": 1,
          "seedMode": "generated",
          "masterSeed": "42",
          "pairing": "shared",
          "pairingGroup": "default",
          "seeds": []
        },
        "tabs": [
          {
            "id": "planner-tab-baseline",
            "name": "baseline",
            "enabled": true,
            "parameterOverrides": {}
          }
        ]
      }
    }
  },
