{
  "version": "2.0",
  "name": "TCELL_CORRAL — FOXP3_2 differentiation",
  "description": "The full Corral T-helper differentiation model: one endothelial cell secretes CCL21, dendritic cells chemotax up the gradient, contact switches on a naive T0 cell's MaBoSS network, which commits a Treg/Th1/Th17 fate. Planner tabs run the WT baseline and the FOXP3_2 / NFKB rate-lower and knockout perturbations.",
  "kernel": "biophysics",
  "seed": 42,
  "metadata": {
    "author": "TCELL_CORRAL builder",
    "created": "2026-07-05",
    "gui": {
      "function_libraries": [],
      "agent_kinds": [
        { "name": "tcell", "init_subworkflow": "tcell_init", "behavior_subworkflows": ["tcell_step"] },
        { "name": "dendritic_cell", "init_subworkflow": null, "behavior_subworkflows": ["dc_step"] },
        { "name": "endothelial_cell", "init_subworkflow": null, "behavior_subworkflows": [] }
      ],
      "resource_kinds": [
        { "name": "CCL21", "init_subworkflow": "ccl21_init", "behavior_subworkflows": ["ccl21_diffuse"] }
      ],
      "world": { "subworkflow": "__world__", "behavior_subworkflows": ["tcell_create", "world_reconcile", "reports"] },
      "init_sequence": { "subworkflow": "__init_sequence__" },
      "scheduler": { "subworkflow": "__scheduler__" },
      "processing": { "behavior_subworkflows": ["final_report"] },
      "main_is_synthesized": true,
      "user_functions": [],
