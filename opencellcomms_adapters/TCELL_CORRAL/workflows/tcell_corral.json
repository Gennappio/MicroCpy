        "tabs": [
          { "id": "tab-wt", "name": "WT", "enabled": true, "parameterOverrides": {} },
          {
            "id": "tab-foxp3-lower", "name": "FOXP3_2_lower", "enabled": false,
            "parameterOverrides": {
              "ti-overrides": { "label": "Up-rate overrides", "targetParam": "up_rate_overrides",
                "entries": [ { "key": "FOXP3_2", "valueType": "float", "value": 0.2 } ] }
            }
          },
          {
            "id": "tab-foxp3-mutant", "name": "FOXP3_2_mutant", "enabled": false,
            "parameterOverrides": {
              "ti-fixed": { "label": "Fixed gene nodes", "targetParam": "fixed_nodes",
                "entries": [ { "key": "FOXP3_2", "valueType": "bool", "value": false } ] }
            }
          },
          {
            "id": "tab-nfkb-lower", "name": "NFKB_lower", "enabled": false,
            "parameterOverrides": {
              "ti-overrides": { "label": "Up-rate overrides", "targetParam": "up_rate_overrides",
                "entries": [ { "key": "NFKB", "valueType": "float", "value": 0.1 } ] }
            }
          },
          {
            "id": "tab-nfkb-mutant", "name": "NFKB_mutant", "enabled": false,
            "parameterOverrides": {
              "ti-fixed": { "label": "Fixed gene nodes", "targetParam": "fixed_nodes",
                "entries": [ { "key": "NFKB", "valueType": "bool", "value": false } ] }
            }
          }
        ]
      },
      "contract_enforcement": "warn"
    }
